#!/bin/bash
#SBATCH --job-name=train-graph
#SBATCH --output=./%x_%A_%a.out
#SBATCH --error=./%x_%A_%a.err
#SBATCH --time=0-2:00:00
#SBATCH --mem=8GB
#SBATCH --partition=cpu-zen4
#SBATCH --cpus-per-task=8
#SBATCH --ntasks=1
#SBATCH --array=1-5
#SBATCH --mail-type=NONE

set -euo pipefail

cd ..

ml purge
ml load ALICE/default
ml load Python/3.12.3-GCCcore-13.3.0
source /home/frohnertf/data1/githubRepos/SAR-QML/.venv/bin/activate

# ── Experiment configuration ──────────────────────────────────────────────────

ARGS=(
    --n-samples 1000 
    --run-name "e1" 
    --n-qubits 2
    --show-progress  
    --n-layers 2  
    --n-epochs 500 
    --n-folds 5
    --fold-index "${SLURM_ARRAY_TASK_ID}"
    --readout-mode single
    --lr 0.005
    --catalyst-batch-size 256
    --quantum-init-scale 0.01

)

echo "Command: python -u experiments/exp3_raw_sar_classification.py ${ARGS[*]}"

python -u experiments/exp3_raw_sar_classification.py "${ARGS[@]}"
