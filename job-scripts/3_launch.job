#!/bin/bash
#SBATCH --job-name=train-graph
#SBATCH --output=./%x_%A_%a.out
#SBATCH --error=./%x_%A_%a.err
#SBATCH --time=0-2:00:00
#SBATCH --mem=8GB
#SBATCH --partition=cpu-zen4
#SBATCH --cpus-per-task=8
#SBATCH --ntasks=1
#SBATCH --array=1-15
#SBATCH --mail-type=NONE

set -euo pipefail

cd ..

ml purge
ml load ALICE/default
ml load Python/3.12.3-GCCcore-13.3.0
source /home/frohnertf/data1/githubRepos/SAR-QML/.venv/bin/activate

TRAIN_SIZE=10
VAL_SIZE=1000
QUBIT_CASES=(2 4 6)
TASK_INDEX=$((SLURM_ARRAY_TASK_ID - 1))
FOLD_INDEX=$((TASK_INDEX % 5 + 1))
QUBIT_INDEX=$((TASK_INDEX / 5))
N_QUBITS="${QUBIT_CASES[$QUBIT_INDEX]}"

if (( QUBIT_INDEX < 0 || QUBIT_INDEX >= ${#QUBIT_CASES[@]} )); then
    echo "Invalid QUBIT_INDEX=${QUBIT_INDEX} for SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID}" >&2
    exit 1
fi

# ── Experiment configuration ──────────────────────────────────────────────────

ARGS=(
    --run-name "e3new" 
    --n-qubits "${N_QUBITS}"
    --show-progress  
    --n-layers 3  
    --n-epochs 500 
    --n-folds 5
    --fold-index "${FOLD_INDEX}"
    --readout-mode single
    --lr 0.005
    --catalyst-batch-size 256
    --quantum-init-scale 0.01
    --fixed-f
    --f-encoding-axis Z
    --train-size "${TRAIN_SIZE}"
    --val-size "${VAL_SIZE}"

)

echo "Running qubits=${N_QUBITS}, fold=${FOLD_INDEX}" 

echo "Command: python -u experiments/exp3_raw_sar_classification.py ${ARGS[*]}"

python -u experiments/exp3_raw_sar_classification.py "${ARGS[@]}"
