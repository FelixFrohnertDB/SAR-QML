#!/bin/bash
#SBATCH --job-name=train-graph
#SBATCH --output=./%x.out
#SBATCH --error=./%x.err
#SBATCH --time=0-4:00:00
#SBATCH --mem=8GB
#SBATCH --partition=cpu-short
#SBATCH --cpus-per-task=8
#SBATCH --ntasks=1
#SBATCH --mail-type=NONE

set -euo pipefail

cd ..

ml purge
ml load ALICE/default
ml load Python/3.12.3-GCCcore-13.3.0
source /home/frohnertf/data1/githubRepos/SAR-QML/.venv/bin/activate

# ── Experiment configuration ──────────────────────────────────────────────────

ARGS=(
    --n-samples 1000 
    --run-name "e1" 
    --n-qubits 2
    --show-progress  
    --n-layers 10  
    --n-epochs 500 
    --n-folds 5

)

echo "Command: python -u experiments/exp2_mnudft_linearity.py ${ARGS[*]}"

python -u experiments/exp2_mnudft_linearity.py "${ARGS[@]}"
