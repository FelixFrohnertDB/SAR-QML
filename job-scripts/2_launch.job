#!/bin/bash
#SBATCH --job-name=train-graph
#SBATCH --output=./%x_%A_%a.out
#SBATCH --error=./%x_%A_%a.err
#SBATCH --time=0-4:00:00
#SBATCH --mem=8GB
#SBATCH --partition=gpu_lion
#SBATCH --account=gpu_lion
#SBATCH --cpus-per-task=8
#SBATCH --ntasks=1
#SBATCH --array=1-5
#SBATCH --mail-type=NONE

set -euo pipefail

cd ..

ml purge
ml load ALICE/default
ml load Python/3.12.3-GCCcore-13.3.0
source /home/frohnertf/data1/githubRepos/SAR-QML/.venv/bin/activate

# ── Experiment configuration ──────────────────────────────────────────────────

ARGS=(
    --n-samples 5000 
    --run-name "e1" 
    --n-qubits 2
    --show-progress  
    --n-layers 8  
    --n-epochs 500 
    --n-folds 5
    --fold-index "${SLURM_ARRAY_TASK_ID}"
    --readout_mode linear
    --learning_rate 0.005
    --catalyst-batch-size 128

)

echo "Command: python -u experiments/exp2_mnudft_linearity.py ${ARGS[*]}"

python -u experiments/exp2_mnudft_linearity.py "${ARGS[@]}"
