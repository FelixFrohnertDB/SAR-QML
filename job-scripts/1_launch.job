#!/bin/bash
#SBATCH --job-name=train-graph
#SBATCH --output=./%x_%A_%a.out
#SBATCH --error=./%x_%A_%a.err
#SBATCH --time=0-1:00:00
#SBATCH --mem=8GB
#SBATCH --partition=cpu-zen4
#SBATCH --cpus-per-task=8
#SBATCH --ntasks=1
#SBATCH --array=1-5
#SBATCH --mail-type=NONE

set -euo pipefail

cd ..

ml purge
ml load ALICE/default
ml load Python/3.12.3-GCCcore-13.3.0
source /home/frohnertf/data1/githubRepos/SAR-QML/.venv/bin/activate

# ── Experiment configuration ──────────────────────────────────────────────────

ARGS=(
    --n-samples 2000 
    --run-name "e1new" 
    --n-qubits 2
    --show-progress  
    --n-layers 3  
    --n-epochs 500 
    --n-folds 5
    --fold-index "${SLURM_ARRAY_TASK_ID}"
    --readout_mode linear
    --catalyst-batch-size 256
    --quantum-init-scale 0.01
    --fixed-f
    --f-encoding-axis Z

)

echo "Command: python -u experiments/exp1_alignment_ablation.py ${ARGS[*]}"

python -u experiments/exp1_alignment_ablation.py "${ARGS[@]}"
